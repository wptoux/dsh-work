{
  "name": "dsh-work-all",
  "description": "dsh-work 聚合包：一条命令装齐当前保留的 2 款插件（remote-web-ui / usage-stats）。纯载具包（无自有插件逻辑），dependencies 拉入子包，cordis.patch.yml 汇总各子包的挂载行。",
  "version": "0.2.0",
  "license": "MIT",
  "files": [
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-remote-web-ui": "github:wptoux/dsh-work#plugins-2026.09.2&path:plugins/dsh-remote-web-ui",
    "dsh-usage-stats": "github:wptoux/dsh-work#plugins-2026.09.2&path:plugins/dsh-usage-stats"
  }
}
